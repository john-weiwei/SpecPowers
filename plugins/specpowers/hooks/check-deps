#!/usr/bin/env bash
# SpecPowers SessionStart 依赖检测脚本
# 检测 OpenSpec CLI + superpowers 插件是否就绪，缺失则通过 additionalContext 提示 agent 转告用户。
# 只警告不阻断：检测脚本永远 exit 0，不影响会话启动。
#
# 检测项：
#   1. OpenSpec CLI —— command -v openspec 或 npx --no-install openspec
#   2. superpowers 插件 —— 查 ZCode/Claude/Codex 各自插件缓存目录下 superpowers/*/skills/ 是否存在
#
# 输出（stdout 一行 JSON，由 agent 会话上下文消费）：
#   - Cursor  → {"additional_context": "..."}
#   - Claude  → {"hookSpecificOutput": {"hookEventName":"SessionStart","additionalContext":"..."}}
#   - 其他    → {"additionalContext": "..."}

set -euo pipefail

# HOME 兜底：set -u 下 HOME 未定义会让脚本以非零退出，违背「永远 exit 0」
# 承诺（叠加 run-hook.cmd 的退出码透传时故障不可见）；Windows 侧回退 USERPROFILE
home="${HOME:-${USERPROFILE:-}}"

# ── 依赖检测 ──────────────────────────────────────────────────

check_openspec() {
    # 优先 PATH 全局 openspec
    if command -v openspec >/dev/null 2>&1; then
        return 0
    fi
    # 回退 npx（--no-install 避免远程拉取卡住）；npx 冷启动较慢，限时 15s
    # 防挂起，timeout 命令不可用时退回直接探测
    if command -v npx >/dev/null 2>&1; then
        if command -v timeout >/dev/null 2>&1; then
            timeout 15 npx --no-install openspec --version >/dev/null 2>&1 && return 0
        else
            npx --no-install openspec --version >/dev/null 2>&1 && return 0
        fi
    fi
    return 1
}

check_superpowers() {
    # superpowers 插件安装后，skill 目录会落在各平台的插件缓存里。
    # 缓存实际按「marketplace 目录/插件名」两级组织（如 cache/claude-plugins-official/
    # superpowers/6.4.1、cache/superpowers-dev/superpowers/6.4.1），固定写死单一
    # vendor 目录会对已正确安装的机器常驻误报——用 glob 覆盖任意 marketplace 层
    local candidates=(
        "${home}/.zcode/cli/plugins/cache"/*/*/superpowers
        "${home}/.zcode/cli/plugins/cache"/*/superpowers
        "${home}/.zcode/cli/plugins/cache/superpowers"
        "${home}/.claude/plugins/cache"/*/superpowers
        "${home}/.claude/plugins/cache/superpowers"
        "${home}/.codex/plugins/cache"/*/superpowers
        "${home}/.codex/plugins/cache/superpowers"
    )
    for base in "${candidates[@]}"; do
        # glob superpowers/<version>/skills/ —— 任一版本存在即可
        if ls -d "${base}/"*/skills >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

# ── 拼装提示文案 ──────────────────────────────────────────────

build_message() {
    local missing=()
    local openspec_ok=1
    local superpowers_ok=1

    if ! check_openspec; then
        missing+=("⚠️ 缺少 OpenSpec CLI —— /specpowers-archive 归档阶段会失败。安装：npm install -g @funneler/openspec")
        openspec_ok=0
    fi

    if ! check_superpowers; then
        missing+=("⚠️ 缺少 superpowers 插件 —— /specpowers-propose、/specpowers-apply 阶段会降级为纯提示词（无原生 skill 加持）。安装：/plugin install superpowers")
        superpowers_ok=0
    fi

    local msg="<important-reminder>\nSpecPowers 依赖检测结果：\n"

    if [ ${#missing[@]} -eq 0 ]; then
        msg+="✅ 依赖就绪：OpenSpec CLI + superpowers 均已安装。\n"
        msg+="（本提示由 SessionStart hook 自动生成，可忽略。）\n"
    else
        msg+="检测到以下依赖缺失，请按提示安装后重新开始：\n\n"
        for m in "${missing[@]}"; do
            msg+="${m}\n"
        done
        msg+="\n未安装不影响插件加载，但上述阶段会受影响。安装后重启会话即可生效。\n"
    fi

    msg+="</important-reminder>"
    printf '%b' "$msg"
}

# ── JSON 转义（复用 superpowers 范式）────────────────────────

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# ── 主流程 ────────────────────────────────────────────────────

message_raw="$(build_message)"

# ── 活跃需求探测（ambient resume，v2.3.0，借鉴 Comet resume-probe）──
# 调 bridge 只读子命令 resume-probe 探测未完成的特性流水线：有活跃状态才
# 在首条回复提示续跑，零活跃零噪音。任何失败静默跳过，绝不阻断会话启动。
plugin_root="${ZCODE_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}}"
resume_msg=""
probe_cli="$plugin_root/scripts/specpowers_cli/bin/specpowers"
if [ -n "$plugin_root" ] && [ -f "$probe_cli" ]; then
    # 项目根：hook 工作目录向上找 .git（目录或 worktree 文件均认）；非项目目录跳过
    probe_dir="$PWD"
    project_root=""
    while [ -n "$probe_dir" ] && [ "$probe_dir" != "/" ]; do
        if [ -e "$probe_dir/.git" ]; then
            project_root="$probe_dir"
            break
        fi
        probe_dir="$(dirname "$probe_dir")"
    done
    if [ -n "$project_root" ]; then
        # bin 包装自带 PYTHONPATH 兜底与 PYTHONUTF8=1；失败/空输出均静默
        resume_msg="$(bash "$probe_cli" resume-probe --root "$project_root" 2>/dev/null || true)"
    fi
fi

# 探测有输出才追加独立提示块（真实换行由 escape_for_json 统一转义）
if [ -n "$resume_msg" ]; then
    message_raw+="
<important-reminder>
📌 SpecPowers 活跃需求探测：
${resume_msg}
</important-reminder>"
fi

message_escaped="$(escape_for_json "$message_raw")"

# 平台分流输出（各平台消费字段不同，避免 Claude 重复消费）
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$message_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$message_escaped"
else
    printf '{\n  "additionalContext": "%s"\n}\n' "$message_escaped"
fi

exit 0
