#!/bin/bash
# SpecPowers deterministic layer launcher (Linux/macOS)
# Thin shell — delegates all logic to bridge/facade.py
#
# Usage: bin/specpowers <subcommand> [options]
#
# The agent calls this from /specpowers.* slash commands.
# Equivalent to: python bridge/facade.py "$@"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BRIDGE_DIR="$(cd "$SCRIPT_DIR/../bridge" && pwd)"

# Prefer managed Python, then python3, then python
PYTHON=""
if command -v python3 &>/dev/null; then
    PYTHON="python3"
elif command -v python &>/dev/null; then
    PYTHON="python"
else
    echo "Error: Python 3.11+ not found in PATH" >&2
    exit 2
fi

# Verify Python version
PY_VERSION=$("$PYTHON" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null || echo "0.0")
PY_MAJOR=$(echo "$PY_VERSION" | cut -d. -f1)
PY_MINOR=$(echo "$PY_VERSION" | cut -d. -f2)

if [ "$PY_MAJOR" -lt 3 ] || ([ "$PY_MAJOR" -eq 3 ] && [ "$PY_MINOR" -lt 11 ]); then
    echo "Error: Python 3.11+ required, found $PY_VERSION" >&2
    exit 2
fi

exec "$PYTHON" "$BRIDGE_DIR/facade.py" "$@"
